# Supabase sozlamalari (Supabase -> Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI sozlamalari (kamida bittasi bo‘lishi shart; ikkalasi bo‘lsa avtomatik zaxira ishlaydi)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FAST_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_PRIORITY=
AI_ATTEMPT_MS=
AI_DEADLINE_MS=

# Bozor va to‘lov sozlamalari
LISTING_FEE_MODE=
PAY_INFO=

# Email va Push bildirishnomalar (ixtiyoriy)
RESEND_API_KEY=
FROM_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=

# Supabase Cron is the default scheduler; enable only for an always-on Node fallback.
REMINDER_NODE_TIMER=0
