# Supabase sozlamalari (Supabase -> Settings -> API)
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_ANON_KEY=...            # ochiq kalit (anon public)
SUPABASE_SERVICE_ROLE_KEY=...    # YASHIRIN! Faqat serverda (Render / VPS)

# AI sozlamalari (kamida bittasi bo‘lishi shart; ikkalasi bo‘lsa avtomatik zaxira ishlaydi)
GEMINI_API_KEY=...               # YASHIRIN! aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=sk-...            # YASHIRIN! platform.openai.com (ixtiyoriy, zaxira/asosiy)
OPENAI_MODEL=gpt-4o-mini
AI_PRIORITY=gemini,openai        # birinchisi band/limit bo‘lsa, avtomatik ikkinchisiga o‘tadi
AI_ATTEMPT_MS=14000              # har bir model urinishi uchun maksimal vaqt (ms)
AI_DEADLINE_MS=45000             # umumiy AI javob chegarasi (Render 100s da uzadi)

# Bozor va to‘lov sozlamalari
LISTING_FEE_MODE=off             # off = e’lon bepul va darhol chiqadi; manual = 10 000 so‘m (admin tasdiqlaydi)
PAY_INFO=Karta: 8600 0000 0000 0000 (Ism Familiya). Izohga telefon raqamingizni yozing, chekni @sizning_telegram ga yuboring.

# Email va Push bildirishnomalar (ixtiyoriy)
RESEND_API_KEY=re_...            # YASHIRIN! resend.com (o‘z domeningizni tasdiqlang)
FROM_EMAIL=Fermer Tog‘a AI <no-reply@sizning-domen.uz>
VAPID_PUBLIC_KEY=...             # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=...            # YASHIRIN!
CRON_SECRET=uzun-tasodifiy-matn  # YASHIRIN! Eslatmalar va /api/ai-test?key=... uchun
